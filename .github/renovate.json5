{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  rangeStrategy: 'pin',
  postUpdateOptions: [
    'gomodTidy',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  semanticCommits: 'enabled',
  semanticCommitScope: 'deps',
  schedule: [
    'before 6am on Monday',
  ],
  minimumReleaseAge: '3 days',
  prConcurrentLimit: 4,
  prHourlyLimit: 2,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+_VERSION(?: :=|:) (?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'pinDigest',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      matchDatasources: [
        'github-actions',
      ],
      groupName: 'GitHub Actions',
    },
    {
      matchDatasources: [
        'go',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Go modules (non-major)',
    },
    {
      matchPackageNames: [
        '/oapi-codegen/',
      ],
      matchDatasources: [
        'go',
      ],
      prBodyNotes: 'Regenerate models.gen.go with `make generate` and commit it.',
    },
    {
      matchDatasources: [
        'golang-version',
      ],
      enabled: false,
    },
    {
      matchDepTypes: [
        'require',
      ],
      semanticCommitType: 'build',
    },
    {
      matchJsonata: [
        'isLockfileUpdate = true',
      ],
      semanticCommitType: 'chore',
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 3am on Monday',
    ],
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
}
